# Copy this file to .env and fill in every required value before deployment.
# Use the server's public URL, including the scheme and port when needed.
BASE_URL=

# Generate each secret separately, for example: openssl rand -hex 32
JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Choose a strong password for the first dashboard login.
INITIAL_PASSWORD=

BIND_ADDRESS=0.0.0.0
PORT=20128

# Set to true when BASE_URL uses HTTPS.
AUTH_COOKIE_SECURE=false
